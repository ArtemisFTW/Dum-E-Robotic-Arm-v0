Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 44
    Fixed Frame: base_link
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: Calculated target (no encoders)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.8
      Focal Point: {X: 0.08, Y: 0.0, Z: 0.12}
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 750
